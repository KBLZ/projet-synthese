<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
		x:Class="AvaloniaApplication1.Views.PrintExportWindow"
		x:DataType="vm:PrintExportViewModel"
		Title="Impression / Exportation"
		Width="635" Height="520"
		WindowStartupLocation="CenterOwner"
		CanResize="False">

	<DockPanel Margin="20">

		<!-- Titre -->
		<TextBlock DockPanel.Dock="Top"
				   Text="Sélectionner les tableaux à exporter"
				   FontSize="15" FontWeight="Bold"
				   Margin="0,0,0,12"/>

		<!-- Sélectionner tout -->
		<CheckBox DockPanel.Dock="Top"
				  Content="Sélectionner tous"
				  IsChecked="{Binding SelectAll}"
				  FontWeight="SemiBold"
				  Margin="0,0,0,6"/>

		<Separator DockPanel.Dock="Top" Margin="0,0,0,10"/>

		<!-- Boutons du bas -->
		<StackPanel DockPanel.Dock="Bottom"
					Orientation="Horizontal"
					HorizontalAlignment="Center"
					Spacing="20" Margin="0,15,0,0">

			<Button
			Command="{Binding ExportCommand}"
			Width="185"
			HorizontalContentAlignment="Center"
			VerticalContentAlignment="Center">
				<StackPanel Orientation="Horizontal" >
					<!-- L'icône -->
					<Image Source="/Assets/Exporter.png"
						   Width="30" Height="30"/>
					<!-- Le texte -->
					<TextBlock Text="Exporter (.xlsx)"
							   Margin="10,10,0,10"/>
				</StackPanel>
			</Button>

			<Button
			Command="{Binding PrintCommand}"
			Width="185"
			HorizontalContentAlignment="Center"
			VerticalContentAlignment="Center">
				<StackPanel Orientation="Horizontal" >
					<!-- L'icône -->
					<Image Source="/Assets/Imprimer.png"
						   Width="30" Height="30"/>
					<!-- Le texte -->
					<TextBlock Text="Imprimer"
							   Margin="10,10,0,10"/>
				</StackPanel>
			</Button>

			<Button
			Command="{Binding CloseCommand}"
			Width="185"
			HorizontalContentAlignment="Center"
			VerticalContentAlignment="Center">
				<StackPanel Orientation="Horizontal" >
					<!-- L'icône -->
					<Image Source="/Assets/Fermer.png"
						   Width="30" Height="30"/>
					<!-- Le texte -->
					<TextBlock Text="Fermer la fenêtre"
							   Margin="10,10,0,10"/>
				</StackPanel>
			</Button>

		</StackPanel>

		<!-- Message si aucune sélection -->
		<TextBlock DockPanel.Dock="Bottom"
				   Text="⚠ Veuillez sélectionner au moins un tableau."
				   Foreground="OrangeRed"
				   FontSize="11"
				   Margin="0,8,0,0"
				   IsVisible="{Binding AucuneSelection}"/>

		<!-- Liste des tableaux de la sidebar -->
		<ScrollViewer>
			<ItemsControl ItemsSource="{Binding TableauxDisponibles}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<CheckBox IsChecked="{Binding IsSelected}"
								  Margin="4,5,0,0">
							<TextBlock>
								<Run Text="{Binding Numero}" FontWeight="Bold"/>
								<Run Text=" — "/>
								<Run Text="{Binding Titre}"/>
							</TextBlock>
						</CheckBox>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

	</DockPanel>
</Window>